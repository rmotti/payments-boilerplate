APP_ENV=development
HTTP_ADDRESS=:8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://payments:payments_local@localhost:5432/payments?sslmode=disable
DATABASE_MAX_OPEN_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=30m
INTEGRATION_API_KEYS=
STRIPE_SECRET_KEY=
# Obrigatorio para a API: assina a verificacao do endpoint de webhook.
# Obtido em `stripe listen` ou no endpoint criado no Dashboard.
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/docs/?checkout=success
STRIPE_CANCEL_URL=http://localhost:8080/docs/?checkout=cancelled
RABBITMQ_URL=amqp://payments:payments_local@localhost:5672/
# Relay do outbox, executado dentro do worker. O intervalo e o piso da latencia
# de publicacao quando a fila esta vazia; um ciclo que publicou algo nao espera.
OUTBOX_BATCH_SIZE=20
OUTBOX_INTERVAL=1s
# O lease precisa cobrir a publicacao do lote e reservar tempo para gravar o
# desfecho: a aplicacao recusa subir se for curto demais para o batch.
OUTBOX_LEASE_DURATION=2m
# Backoff das falhas transitorias, com jitter. Falha transitoria nunca descarta
# uma mensagem, por mais que se repita.
OUTBOX_BACKOFF_BASE=2s
OUTBOX_BACKOFF_MAX=5m
# Apenas quando alertar sobre uma mensagem travada. Nao interrompe as tentativas.
OUTBOX_ALERT_AFTER_ATTEMPTS=10
# Consumer, executado dentro do worker ao lado do relay. O prefetch precisa ser
# pelo menos igual a concorrencia, senao os workers ficam ociosos esperando
# mensagens que o broker nao pode entregar.
CONSUMER_CONCURRENCY=4
CONSUMER_PREFETCH=4
# Diferente do relay, o consumer tem limite: uma falha transitoria aqui pode ser
# um bug que nunca termina, e a DLQ e onde ela fica visivel.
CONSUMER_MAX_ATTEMPTS=10
# Faixas de espera entre tentativas, uma fila por faixa. A ultima se repete ate
# o limite acima. Precisam ser positivas e estritamente crescentes.
CONSUMER_RETRY_DELAYS=5s,30s,2m,10m
LOG_LEVEL=debug
LOG_FORMAT=console
STARTUP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
OTEL_ENABLED=false
OTEL_SERVICE_NAME=payments-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_INTERVAL=10s
